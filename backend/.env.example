NODE_ENV=development
PORT=4000

# DATABASE_URL: pooled connection URL (Neon host with -pooler)
# DIRECT_URL: direct, non-pooled connection URL (used by Prisma Migrate)
# Copy both URLs from your managed PostgreSQL provider. Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER:5432/imobgestor?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/imobgestor?sslmode=require"

# Local frontend origin during development; on Vercel set your production frontend URL.
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Generate a new random value. Never reuse the example or share the real secret.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# Leave blank when using the frontend Vercel rewrite proxy / same-origin API.
COOKIE_DOMAIN=

# Cloudflare R2 or another S3-compatible PRIVATE bucket.
# Leave blank until you create the bucket and its access keys.
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE_MB=25
